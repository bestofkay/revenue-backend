# Railway environment reference
# Copy these into each Railway service (Variables tab).
# Use Railway reference syntax so services stay linked.

# ═══════════════════════════════════════════════════════════════════════════
# Shared secrets (set once on API, or duplicate)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═══════════════════════════════════════════════════════════════════════════
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# HMAC_PAYMENT_SECRET=
# FIELD_ENCRYPTION_KEY=   # 64+ hex chars (openssl rand -hex 32)

# ═══════════════════════════════════════════════════════════════════════════
# API service variables
# ═══════════════════════════════════════════════════════════════════════════
NODE_ENV=production
API_PREFIX=api/v1
API_URL=auto
TENANT_AGENCY_CODE=NCS
COOKIE_SECURE=true
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
DEFAULT_CURRENCY=NGN

# Link Railway MySQL plugin (preferred) — Prisma expects mysql://
DATABASE_URL=${{MySQL.MYSQL_URL}}

# Link Railway Redis plugin
REDIS_URL=${{Redis.REDIS_URL}}

# Link custom RabbitMQ service (private networking)
RABBITMQ_URL=amqp://revenue:${{RabbitMQ.RABBITMQ_DEFAULT_PASS}}@${{RabbitMQ.RAILWAY_PRIVATE_DOMAIN}}:5672
RABBITMQ_USER=revenue
RABBITMQ_PASS=${{RabbitMQ.RABBITMQ_DEFAULT_PASS}}
RABBITMQ_HOST=${{RabbitMQ.RAILWAY_PRIVATE_DOMAIN}}

# Web hosts admin + public pay portal — use the same origin for both
APP_URL=https://${{Web.RAILWAY_PUBLIC_DOMAIN}}
PAY_URL=https://${{Web.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGINS=https://${{Web.RAILWAY_PUBLIC_DOMAIN}}

# ═══════════════════════════════════════════════════════════════════════════
# Web service variables (admin + /pay + /receipts)
# Rebuild after changing NEXT_PUBLIC_* (baked in at build time)
# ═══════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=https://${{Api.RAILWAY_PUBLIC_DOMAIN}}/api/v1

# ═══════════════════════════════════════════════════════════════════════════
# RabbitMQ service variables
# ═══════════════════════════════════════════════════════════════════════════
RABBITMQ_DEFAULT_USER=revenue
# RABBITMQ_DEFAULT_PASS=<generate a strong password>
